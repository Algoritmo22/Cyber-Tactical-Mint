# Configuración Avanzada de 5 Terminales Unidas en una Sola Ventana
layout splits

# Panel 1: Esquina Superior Izquierda (Monitoreo)
launch sh -c "echo '🛰️  1. INTERCEPTOR DE REDES (tcpdump)'; exec bash"

# Panel 2: Esquina Inferior Izquierda (Herramientas Adicionales)
launch --location=hsplit sh -c "echo '📂 3. SCRIPTS DE PYTHON / UTILS'; exec bash"

# Panel 3: LA CENTRAL EN EL CENTRO EXACTO (Cracking Inalámbrico con Máscara en Rombo)
# Se posiciona en medio uniendo las 4 esquinas
launch --location=vsplit sh -c "
  clear;
  echo '         /\         ';
  echo '        /  \        ☠️  5. CENTRAL DE AUDITORÍA INALÁMBRICA';
  echo '       / ☠️  \       -------------------------------------';
  echo '      / CRACK \     Herramientas: aircrack-ng / hcxtools ';
  echo '     /  WIFI   \    -------------------------------------';
  echo '     \  MODE   /    Escaneando Handshakes en vivo...     ';
  echo '      \       /     ';
  echo '       \     /      ';
  echo '        \   /       ';
  echo '         \/         ';
  exec bash
"

# Panel 4: Esquina Superior Derecha (Ataque y Explotación)
launch --location=vsplit sh -c "echo '⚡ 2. CONSOLA DE ATAQUES / METASPLOIT'; exec bash"

# Panel 5: Esquina Inferior Derecha (Reconocimiento)
launch --location=hsplit sh -c "echo '🔍 4. RECONOCIMIENTO ACTIVO (nmap)'; exec bash"
