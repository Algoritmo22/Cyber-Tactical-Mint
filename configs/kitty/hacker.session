# Configuración avanzada de 5 terminales integradas para Pentesting Activo
layout splits

# Panel 1: Esquina Superior Izquierda (Monitoreo)
launch sh -c "echo '🛰️  1. INTERCEPTOR DE REDES (tcpdump)'; exec bash"

# Panel 2: Esquina Inferior Izquierda (Herramientas Adicionales)
launch --location=hsplit sh -c "echo '📂 3. SCRIPTS DE PYTHON / UTILS'; exec bash"

# Panel 3: LA CENTRAL EN EL CENTRO EXACTO (Cracking Inalámbrico en Rombo)
launch --location=vsplit sh -c "printf '         /\\\         \n        /  \\\        ☠️  5. CENTRAL DE AUDITORÍA\n       / ☠️  \\\       -------------------------------------\n      / CRACK \\\     Herramientas: aircrack-ng / hcxtools \n     /  WIFI   \\\    -------------------------------------\n     \\\  MODE   /    Escaneando Handshakes en vivo...     \n      \\\       /     \n       \\\     /      \n        \\\   /       \n         \\\/         \n'; exec bash"

# Panel 4: Levanta el servidor local de Ollama e inicia la IA Dolphin de inmediato
launch sh -c "echo '🤖 4. INICIALIZANDO INTELIGENCIA ARTIFICIAL LOCAL...'; ollama serve & sleep 2 && ollama run dolphin-llama3"

# Panel 5: Esquina Inferior Derecha (Reconocimiento)
launch --location=hsplit sh -c "echo '🔍 4. RECONOCIMIENTO ACTIVO (nmap)'; exec bash"
